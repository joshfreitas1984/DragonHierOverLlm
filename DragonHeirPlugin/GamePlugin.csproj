<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FanslationStudio.EnglishPatch</AssemblyName>
    <Product>English Patch by FanslationStudio</Product>
    <Version>1.0.0</Version>
    <Authors>joshfreitas1984</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>EnglishPatch</RootNamespace>
    <GameDir>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\plugins</GameDir>
    <ReleaseFolder>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\ReleaseFolder\Files\BepInEx\plugins</ReleaseFolder>
    <!-- BepInEx's SDK/props force CopyLocalLockFileAssemblies=false project-wide, which means a
         plain PackageReference (e.g. System.Text.Encoding.CodePages, added for GBK decode
         support) is never copied into bin/ at all - so Costura.Fody (which embeds by scanning
         the build output folder) has nothing to pick up for it, even though it does successfully
         embed the interop <Reference>/HintPath assemblies (those default to copy-local
         regardless of this setting). Overriding it back to true here for just this project lets
         package-reference DLLs land in bin/ again so Costura can embed them too. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.785" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- Needed to decode GBK-encoded TextAsset bytes (some game data files are not UTF-8 -
         see ResourceIoPatches.DecodeAssetBytes). .NET Core only ships UTF-8/UTF-16/UTF-32/ASCII
         by default; CodePagesEncodingProvider adds codepage 936 (GBK) support.
         BepInEx's SDK sets CopyLocalLockFileAssemblies=false project-wide, so a plain
         PackageReference is never copied to the output/plugins folder (confirmed via
         `dotnet build -v:diag`) - it must be embedded into the main plugin DLL via Costura.Fody
         (see FodyWeavers.xml) instead, same as any other external dependency here. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="7.0.0" />
    <!-- Parses the PrefabText raw/result YAML dictionary (Files/Mod/*.yaml, produced by
         FanslationStudio.LlmKit.Workflow.PrefabTextWorkflow.PackagePrefabTextAsync) in
         PrefabTextPatches.cs. Same CopyLocalLockFileAssemblies/Costura embedding requirement as
         System.Text.Encoding.CodePages above. -->
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\Il2CppSystem.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>G:\SteamLibrary\steamapps\common\LongYinLiZhiZhuan\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <Exec Command="XCOPY /Y /I &quot;$(TargetDir)$(TargetName)$(TargetExt)&quot; &quot;$(GameDir)&quot;" />
    <Exec Command="XCOPY /Y /I &quot;$(TargetDir)$(TargetName)$(TargetExt)&quot; &quot;$(ReleaseFolder)&quot;" />
  </Target>
</Project>
